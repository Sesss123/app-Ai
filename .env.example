# Copy to .env and fill only the values required by the script you run.
# Never commit .env or real credentials.
KAGGLE_USERNAME=
KAGGLE_KEY=
HF_TOKEN=
ROBOFLOW_API_KEY=

# TripMe backend defaults to retrieval_only. Use transformers only on a capable local GPU.
TRIPME_MODEL_MODE=retrieval_only
TRIPME_REGISTRY=data/registry/place_registry_v0.1.0.jsonl
TRIPME_ADAPTER=artifacts/part10_corrective
TRIPME_CORS_ORIGINS=*
